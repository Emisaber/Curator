{
  "data_root": "/path/to/ego4d",
  "output": "/path/to/ego4d-recaption",
  "sources": ["fho", "narration"],
  "caption_version": "v1",
  "inference_server": {
    "environment": "/path/to/vllm-env",
    "model_path": "/path/to/model",
    "num_replicas": 2,
    "engine_kwargs": {
      "tensor_parallel_size": 1,
      "mm_encoder_tp_mode": "data",
      "max_model_len": 8192,
      "max_num_seqs": 512
    },
    "env_vars": {
      "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
      "VLLM_USE_RUST_FRONTEND": "1"
    }
  },
  "batch_size": 64,
  "extraction_workers": 4,
  "caption_workers": 8,
  "requests_per_worker": 8,
  "max_image_edge": 1024,
  "max_output_tokens": 2048,
  "num_cpus": 16,
  "num_gpus": 2,
  "retry_failed": false
}
