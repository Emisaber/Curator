{
  "subset": "/path/to/subset",
  "output": "/path/to/curation-run",
  "schema_version": "1",
  "seed": 42,
  "dedup": {
    "model_dir": "/path/to/clip-models",
    "num_cpus": 80,
    "num_gpus": 4,
    "reader_workers": 8,
    "reader_gpus_per_worker": 0.25,
    "clip_workers": 8,
    "clip_gpus_per_worker": 0.25,
    "batch_size": 32,
    "n_clusters": 100,
    "review_pairs": 240
  },
  "vlm": {
    "schema_version": "1",
    "prompt_version": "v2",
    "fields": [
      "visual_quality",
      "clarity",
      "exposure",
      "color_cast",
      "rendered_text",
      "text_coverage",
      "watermark",
      "logo",
      "visible_artifacts",
      "scene_type"
    ],
    "inference_server": {
      "environment": "/path/to/vllm-env",
      "model_path": "/path/to/model",
      "num_replicas": 2,
      "engine_kwargs": {
        "tensor_parallel_size": 1,
        "mm_encoder_tp_mode": "data",
        "max_model_len": 8192,
        "max_num_seqs": 512
      },
      "env_vars": {
        "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
        "VLLM_USE_RUST_FRONTEND": "1"
      }
    },
    "batch_size": 32,
    "reader_workers": 4,
    "reader_gpus_per_worker": 0.25,
    "annotation_workers": 64,
    "requests_per_worker": 8,
    "num_cpus": 80,
    "num_gpus": 3
  },
  "nsfw": {
    "model_dir": "/path/to/model_weights",
    "num_cpus": 8,
    "num_gpus": 1,
    "annotation_workers": 4,
    "num_gpus_per_worker": 0.25,
    "model_inference_batch_size": 32
  },
  "hpsv3": {
    "hps_python": "/path/to/hpsv3-env/bin/python",
    "checkpoint": "/path/to/HPSv3.safetensors",
    "model_config": "/path/to/HPSv3_7B.yaml",
    "replicas": 1,
    "num_cpus": 20,
    "num_gpus": 1,
    "annotation_workers": 16,
    "inference_batch_size": 16,
    "max_model_batch_size": 256,
    "batch_wait_ms": 50
  }
}
